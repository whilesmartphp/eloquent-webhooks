{
  "name": "whilesmart/eloquent-webhooks",
  "description": "Webhook management package for Laravel applications",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "authors": [
    {
      "name": "WhileSmart",
      "email": "engineering@whilesmart.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^10.4",
    "laravel/sanctum": "^4.0",
    "zircote/swagger-php": "^5.1",
    "nunomaduro/collision": "^8.8",
    "laravel/pint": "^1.22",
    "fakerphp/faker": "^1.24",
    "phpmd/phpmd": "@stable",
    "phpstan/phpstan": "^2.1",
    "larastan/larastan": "^3.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "suggest": {
    "whilesmart/activities": "For webhook-triggered activity creation"
  },
  "autoload": {
    "psr-4": {
      "Whilesmart\\Webhooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Workbench\\App\\": "workbench/app/",
      "Whilesmart\\Webhooks\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Whilesmart\\Webhooks\\WebhooksServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3"
    }
  },
  "scripts": {
    "pint": [
      "./vendor/bin/pint --preset psr12"
    ],
    "pint:test": [
      "./vendor/bin/pint --preset psr12 --test"
    ],
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "@php vendor/bin/pint --preset psr12 --ansi"
    ],
    "phpmd": [
      "vendor/bin/phpmd src text phpmd.xml"
    ],
    "phpstan": "phpstan analyse src --memory-limit=2048M --level=5",
    "phpcs": "phpcbf src",
    "phpcs:test": "phpcs src",
    "test": "vendor/bin/testbench package:test --coverage"
  }
}
