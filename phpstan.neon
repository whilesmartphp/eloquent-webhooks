includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    excludePaths:
        - app/Http/Resources/*
    reportUnmatchedIgnoredErrors: false

    # Ignore specific error patterns
    ignoreErrors:
        - '#PHPDoc tag @SuppressWarnings#'
        # Consumer-facing trait; used by host application models, not within the package.
        - '#Trait Whilesmart\\Webhooks\\Traits\\HasWebhooks is used zero times#'
